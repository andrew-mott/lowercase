{
  "name": "transcribe",
  "version": "0.1.0-alpha.14",
  "description": "Speech-to-text with Speaches, an LLM pass that corrects the transcript, then the original audio archived. One http step per body kind: multipart, json, artifact.",
  "start": "transcribe",
  "params": {
    "audio": {
      "type": "text/plain"
    }
  },
  "steps": {
    "transcribe": {
      "type": "http",
      "url": "http://localhost:8000/v1/audio/transcriptions",
      "method": "POST",
      "body": {
        "multipart": {
          "file": {
            "artifact": "{{params.audio}}",
            "filename": "input.wav"
          },
          "model": "Systran/faster-distil-whisper-small.en"
        }
      },
      "exports": {
        "text": {
          "ref": "{{output.body.text}}",
          "type": "text/plain"
        }
      },
      "on": {
        "success": "correct"
      }
    },
    "correct": {
      "type": "http",
      "url": "http://192.168.1.75:8000/v1/chat/completions",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer local-key"
      },
      "body": {
        "json": {
          "model": "local-mistral",
          "messages": [
            {
              "role": "system",
              "content": "Correct this speech-to-text transcript. Fix misheard technical terms (for example, Redis Streams). Return only the corrected text."
            },
            {
              "role": "user",
              "content": "{{steps.transcribe.exports.text}}"
            }
          ],
          "temperature": 0
        }
      },
      "exports": {
        "text": {
          "ref": "{{output.body.choices[0].message.content}}",
          "type": "text/plain"
        }
      },
      "on": {
        "success": "archive"
      }
    },
    "archive": {
      "type": "http",
      "url": "http://localhost:9000/recordings/input.wav",
      "method": "PUT",
      "body": {
        "artifact": "{{params.audio}}"
      }
    }
  }
}
