# Integration-test config for packages/adapters -- loaded automatically via
# a vitest setupFile (see packages/adapters/tests/setup-env.ts), separate
# from the real .env (which only carries DATABASE_URL). Copy this file to
# .env.test.local (already gitignored, matching .env.*.local) to fill it in
# locally; CI supplies the same vars directly via the workflow's env: block
# instead of this file. Every var here is only used when set -- unset means
# the corresponding suite is skipped rather than failing. Run
# `docker compose up -d minio redis` to start local backends matching these
# defaults.

# S3-compatible CAS adapter integration tests.
S3_TEST_ENDPOINT="http://localhost:9000"
S3_TEST_BUCKET="artifacts-test"
S3_TEST_ACCESS_KEY_ID="minioadmin"
S3_TEST_SECRET_ACCESS_KEY="minioadmin"

# RedisMessageLog integration tests.
REDIS_TEST_URL="redis://localhost:6379"

# The SQL repository contract test suites need nothing set: they default to the
# docker-compose Postgres, the same way prisma.postgres.config.ts does, and skip
# the Postgres half when no server answers there. CI sets nothing either.
#
# To move the port, set POSTGRES_HOST_PORT in .env rather than a URL here --
# that one variable moves the compose binding and every default with it. This is
# for naming a different server entirely, which is worth knowing the cost of.
#
# What the suites do to whatever server this names: connect to its `postgres`
# database to issue admin statements, drop and recreate `lcase_test_template`,
# drop and recreate `lcase_test_w<N>` (one per vitest worker), and, via
# check:migrations, create and reset `lcase_shadow`. Those names are the entire
# blast radius -- nothing else is dropped, including the database named below.
# It does need permission to create databases. Deliberately not DATABASE_URL's
# Postgres sibling, so a stray value cannot land this on a database you work in.
#
# POSTGRES_TEST_URL="postgresql://lcase:lcase@localhost:5432/lcase"
