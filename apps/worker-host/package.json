  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --incremental false",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "lint": "eslint .",
    "start": "node ./dist/main.js",
    "dev": "npx tsx ./src/main.ts",
