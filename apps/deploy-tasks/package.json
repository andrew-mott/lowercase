{
  "name": "@lcase/deploy-tasks",
  "version": "0.1.0-alpha.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc --incremental false -p tsconfig.build.json",
    "bundle": "node ../../scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint .",
    "provision": "node ./dist/provision.js",
    "dev:provision": "npx tsx ./src/provision.ts",
    "clean:dist": "node ../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../scripts/clean-node-modules.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@lcase/adapters": "workspace:*",
    "@lcase/message-router": "workspace:*",
    "@lcase/message-topology": "workspace:*",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/events": "workspace:*",
    "@lcase/ports": "workspace:*",
    "@lcase/types": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
