{
  "name": "@lcase/adapters",
  "version": "0.1.0-alpha.14",
  "private": true,
  "type": "module",
  "exports": {
    "./event-bus": {
      "types": "./dist/event-bus/index.d.ts",
      "import": "./dist/event-bus/index.js"
    },
    "./flow-repository": {
      "types": "./dist/flow-repository/index.d.ts",
      "import": "./dist/flow-repository/index.js"
    },
    "./sim-repository": {
      "types": "./dist/sim-repository/index.d.ts",
      "import": "./dist/sim-repository/index.js"
    },
    "./run-repository": {
      "types": "./dist/run-repository/index.d.ts",
      "import": "./dist/run-repository/index.js"
    },
    "./run-step-projection-repository": {
      "types": "./dist/run-step-projection-repository/index.d.ts",
      "import": "./dist/run-step-projection-repository/index.js"
    },
    "./run-settled": {
      "types": "./dist/run-settled/index.d.ts",
      "import": "./dist/run-settled/index.js"
    },
    "./run-query": {
      "types": "./dist/run-query/index.d.ts",
      "import": "./dist/run-query/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./event-store": {
      "types": "./dist/event-store/index.d.ts",
