    },
    "./message-log": {
      "types": "./dist/message-log/index.d.ts",
      "import": "./dist/message-log/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "clean:dist": "node ../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../scripts/clean-node-modules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint ."
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@lcase/db-prisma": "workspace:*",
    "@lcase/specs": "workspace:*",
    "dotenv": "^17.4.2",
    "redis": "^6.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/ports": "workspace:*",
    "@lcase/test-support": "workspace:*",
    "@lcase/types": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@smithy/util-stream": "^4.8.2",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
