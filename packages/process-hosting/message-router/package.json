{
  "name": "@lcase/message-router",
  "version": "0.1.0-alpha.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint .",
    "clean:dist": "node ../../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../../scripts/clean-node-modules.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/events": "workspace:*",
    "@lcase/message-topology": "workspace:*",
    "@lcase/ports": "workspace:*",
    "@lcase/types": "workspace:*",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
