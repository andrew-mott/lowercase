{
  "name": "@lcase/engine",
  "version": "0.1.0-alpha.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint .",
    "clean:dist": "node ../../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../../scripts/clean-node-modules.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@lcase/events": "workspace:*",
    "@lcase/flow-analysis": "workspace:*",
    "@lcase/json-ref-binder": "workspace:*",
    "@lcase/run-history": "workspace:*",
    "@lcase/specs": "workspace:*",
    "immer": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/ports": "workspace:*",
    "@lcase/types": "workspace:*",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
