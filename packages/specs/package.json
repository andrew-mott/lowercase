{
  "name": "@lcase/specs",
  "version": "0.1.0-alpha.14",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "gen": "node scripts/write-generated-types.ts",
    "gen:check": "node scripts/write-generated-types.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "eslint .",
    "clean:dist": "node ../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../scripts/clean-node-modules.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "ajv": "^8.17.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/types": "workspace:*",
    "eslint": "^9.39.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
