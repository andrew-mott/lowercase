{
  "name": "@lcase/test-support",
  "version": "0.1.0-alpha.13",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sql-global-setup": {
      "types": "./dist/sql/global-setup.d.ts",
      "import": "./dist/sql/global-setup.js"
    },
    "./sql-global-setup/sqlite": {
      "types": "./dist/sql/global-setup-sqlite.d.ts",
      "import": "./dist/sql/global-setup-sqlite.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean:dist": "node ../../scripts/clean-dist.mjs",
    "clean:node-modules": "node ../../scripts/clean-node-modules.mjs"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@lcase/db-prisma": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.5.2",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4"
  }
}
