# SQLite is the default install and the authored schema's provider. Nothing has
# to set this: the value below is also the built-in default, shared by the Prisma
# CLI and a running app so the two always name the same file.
#
# A relative `file:` URL resolves against the directory holding this .env, which
# is the one anchor both readers agree on -- the Prisma CLI would otherwise
# resolve it against the schema directory and better-sqlite3 against the working
# directory, so the same string would mean two different files. An absolute path
# is taken as written.
#
# DATABASE_URL="file:./lcase-db/sqlite/dev.db"

# The host port the docker-compose Postgres publishes, and the single knob for
# moving it. Docker Compose reads it from this file directly, and the Prisma
# configs and test harness derive their default URLs from it, so setting it here
# moves all three together. Set it if something already holds 5432 -- a native
# Postgres install, most likely.
#
# POSTGRES_HOST_PORT=5434

# The Postgres database the Prisma CLI and a running app both use. Defaults to
# the compose service on POSTGRES_HOST_PORT, so set it only to name a different
# server entirely.
#
# Deliberately not what the contract suites read: those create and drop databases
# beside the one named here, so they take POSTGRES_TEST_URL instead.
#
# POSTGRES_DATABASE_URL="postgresql://lcase:lcase@localhost:5432/lcase"
